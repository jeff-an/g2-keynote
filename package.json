{
  "name": "g2-presenter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Keynote speaker notes and next-slide preview on Even Realities G2 glasses",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch helper/server.ts --dev --debug & vite --host --port 5173 --strictPort",
    "dev:mock": "tsx watch helper/server.ts --dev --debug --mock & vite --host --port 5173 --strictPort",
    "start": "npm run build && tsx helper/server.ts",
    "debug": "npm run build && tsx helper/server.ts --debug",
    "mock": "npm run build && tsx helper/server.ts --mock",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pack:ehpk": "npm run build && evenhub pack app.json ./dist -o g2-presenter.ehpk"
  },
  "dependencies": {
    "@evenrealities/pretext": "^0.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
